@namespace Talk.Client.Slides

@* Concept #5: attribute splatting. The component collects undeclared attributes; a caller
   passes extras that land on the root element, and the rendered HTML shows what that produced.
   All three windows at once — the class conflict is one point, narrated, not a build step.
   The output isn't hand-written: it's what a bUnit render of the real Slide component produced,
   and it matches the documented rule — attributes resolve right to left, so the rightmost wins.
   https://learn.microsoft.com/en-us/aspnet/core/blazor/components/splat-attributes-and-arbitrary-parameters *@
<Slide Title="Attribute splatting" Subtitle="The pass-through">
    <div class="splat">
        <CodeWindow FileName="Slide.razor" Language="razor" Code="@Declare" />
        <CodeWindow FileName="Page.razor" Language="razor" Code="@Use" />
        <CodeWindow FileName="rendered HTML" Language="html" Code="@Output" />

        <Caption>
            <code>class</code> and <code>data-track</code> aren't declared parameters, so they're
            collected into <code>Extra</code> and splatted onto the root <code>&lt;div&gt;</code>.
            Without it, an undeclared attribute is a <strong>runtime error</strong>.
        </Caption>
        <Caption Spaced>
            Note <strong><code>class="slide"</code> is gone</strong> — a splat
            <strong>replaces</strong>, it never merges. Attributes resolve
            <strong>right to left</strong>, so the <strong>rightmost wins</strong>.
        </Caption>
    </div>
</Slide>

@code {
    // The component collects the leftovers and splats them onto an element.
    private const string Declare = @"<div class=""slide"" @attributes=""Extra""> ... </div>

@code {
    [Parameter(CaptureUnmatchedValues = true)]
    public IDictionary<string, object>? Extra { get; set; }
}";

    // A caller passes attributes the component never declared.
    private const string Use = @"<Slide Title=""Demo"" class=""wide"" data-track=""intro"" />";

    // The real output — taken from a bUnit render of the actual Slide component, not written by hand.
    private const string Output = @"<div class=""wide"" data-track=""intro"" b-t2m4o9m0u9> ... </div>";
}
