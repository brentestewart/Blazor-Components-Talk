@namespace Talk.Client.Slides

@* Concept #23: component libraries (RCLs). No code window — the csproj is setup, and setup
   surprises nobody. What's worth teaching is what crosses the library boundary and what doesn't,
   so this is a list of the things that actually bite. Every claim is live in this repo:
   App.razor links Talk.styles.css, Deck.razor imports ./_content/BlazorDeck/deck.js, and
   BlazorDeck.csproj carries <SupportedPlatform Include="browser" />.
   Dropped an "_Imports.razor doesn't flow to consumers" point: needing a using statement to
   reach a namespace is ordinary C#, not an RCL gotcha.
   Sub is a MarkupString so literal syntax can be <code>; the tags come from a runtime string, so
   they carry no scope id and the CSS reaches them with ::deep. *@
<Slide Title="Component libraries" Subtitle="The RCL this deck runs on">
    <BulletList Items="_items">
        <ItemTemplate Context="i">
            <strong class="accent">@i.Head</strong> — <span class="sub">@i.Sub</span>
        </ItemTemplate>
    </BulletList>
    <p class="foot">Slide, SplitSlide, CodeWindow, Deck — all of it came out of one class
        library.</p>
</Slide>

@code {
    private record Note(string Head, MarkupString Sub);

    private static readonly Note[] _items =
    {
        new("A component library is just a Razor Class Library",
            (MarkupString)("an RCL — <code>Sdk=\"Microsoft.NET.Sdk.Razor\"</code> on a class "
            + "library. MudBlazor is one.")),
        new("Scoped CSS bundles under the app's name",
            (MarkupString)("your <code>.razor.css</code> ships inside the consumer's "
            + "<code>Talk.styles.css</code>. Not linked, and everything renders unstyled, "
            + "silently.")),
        new("Assets live at _content/{AssemblyName}/",
            (MarkupString)("the assembly name, not the project or NuGet id. Rename it and every "
            + "URL moves.")),
        new("A WebAssembly consumer runs your library in the browser",
            (MarkupString)("so all of it has to be browser-safe — no sockets, no file system. "
            + "<code>&lt;SupportedPlatform Include=\"browser\" /&gt;</code> catches it at "
            + "build, not at runtime.")),
    };
}
