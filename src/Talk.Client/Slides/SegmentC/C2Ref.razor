@namespace Talk.Client.Slides

@* Concept #10: @ref. Capture an <input> and call FocusAsync after the first render.
   Notes sit BELOW the code, not beside it: the OnAfterRenderAsync signature is ~62 chars and
   clipped in a SplitSlide column (.cs-pre clips rather than wraps). Full width fits it easily. *@
<Slide Title="@RefTitle" Subtitle="grab a handle">
    <div class="ref-body">
        <CodeWindow FileName="SearchBox.razor" Language="razor" Code="@Source" />

        <Caption>Sometimes a parent needs to <strong>reach in and call</strong>, not just pass a
            value. <code>@@ref</code> captures a handle: an <code>ElementReference</code> for a DOM
            node to focus, measure, or hand to JS, or a <strong>component</strong> instance so you
            can call its public methods — i.e. <code>_child.Refresh()</code>.</Caption>

        <Caption Spaced>A handle isn't valid until the <em>first render</em>, so use it from an
            event handler or in <code>OnAfterRender</code> — never in the markup or an earlier
            hook.</Caption>
    </div>
</Slide>

@code {
    private const string RefTitle = "@ref";

    private const string Source = @"<input @ref=""_search"" placeholder=""Search"" />

@code {
    ElementReference _search;

    // valid only after render
    protected override async Task OnAfterRenderAsync(bool first)
    {
        if (first) await _search.FocusAsync();
    }
}";
}
